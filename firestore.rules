rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function rest(r) { return get(/databases/$(db)/documents/restaurants/$(r)).data; }
    function planOk(r) { return rest(r).planEnd > request.time; }
    function inR(r) {
      return verified()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && me().rid == r
        && rest(r).status == 'approved'
        && planOk(r);
    }
    function isOwner(r) { return inR(r) && me().role == 'owner'; }
    function isMoney(r) { return inR(r) && me().role in ['owner', 'cashier']; }

    match /admins/{a} {
      allow get: if signedIn() && request.auth.uid == a;
    }

    match /users/{u} {
      allow read: if signedIn() && request.auth.uid == u;
      allow create: if signedIn() && request.auth.uid == u && (
        (request.resource.data.role == 'owner' && rest(request.resource.data.rid).ownerUid == u) ||
        (request.resource.data.role in ['waiter', 'cashier'] &&
         rest(request.resource.data.rid).status == 'approved' &&
         exists(/databases/$(db)/documents/codes/$(request.resource.data.code)) &&
         get(/databases/$(db)/documents/codes/$(request.resource.data.code)).data.rid == request.resource.data.rid &&
         get(/databases/$(db)/documents/codes/$(request.resource.data.code)).data.role == request.resource.data.role));
    }

    match /codes/{c} {
      allow get: if signedIn();
      allow create: if signedIn() && rest(request.resource.data.rid).ownerUid == request.auth.uid;
    }

    // Razorpay / admin payments: fakt admin vanchi shake. Lakhe Worker (server).
    match /payments/{p} {
      allow read, create: if isAdmin();
    }

    match /restaurants/{r} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if isAdmin() || inR(r);
      // Owner fakt tables ane sections badli shake. Status/plan nahi.
      allow update: if isAdmin() || (isOwner(r)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tables', 'sections']));
      allow delete: if isAdmin();

      match /menu/{m} { allow read: if inR(r); allow write: if isOwner(r); }
      match /orders/{o} { allow read, write: if inR(r); }
      match /expenses/{e} { allow read, write: if isOwner(r); }
      match /stats/{s} { allow read, write: if isMoney(r); }
    }
  }
}
